{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WisewareOrg/wise-renovate#v1.8.0"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^fsw/fprime/fprime-tag$/"],
      "matchStrings": ["^(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "nasa/fprime",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^fsw/fprime/CMakeLists\\.txt$/"],
      "matchStrings": ["GIT_TAG (?<currentValue>[0-9][0-9.]*)"],
      "depNameTemplate": "libeigen/eigen",
      "datasourceTemplate": "gitlab-tags"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["nasa/fprime"],
      "postUpgradeTasks": {
        "commands": ["uv lock"],
        "installTools": { "python": {}, "uv": {} },
        "fileFilters": ["uv.lock"],
        "executionMode": "branch"
      }
    }
  ]
}
