// Sets up the @CONFIGURATION@Fsw deployment.
#ifndef WISEFSW_@CONFIGURATION@FSWTOPOLOGY_HPP
#define WISEFSW_@CONFIGURATION@FSWTOPOLOGY_HPP

#include "fsw/fprime/deployment/@CONFIGURATION@/@CONFIGURATION@FswTopologyAc.hpp"
#include "fsw/fprime/platform/Cooperative.hpp"

namespace WiseFsw {

extern Sim::Cooperative cooperative;

//! Sets the topology up: every component idle, its memory taken.
void setupTopology(const TopologyState& state);

//! One frame at the time given; the first ends initialization. Gives the transmit buffers it wrote in `written`, a
//! bit per port. Returns nullptr, or the queue that did not drain, and then runs nothing more and leaves `written`.
const Os::Queue* step(U64 nanoseconds, U32& written);

}  // namespace WiseFsw

#endif
