#include "fsw/fprime/deployment/@CONFIGURATION@/@CONFIGURATION@FswTopology.hpp"

#include "Os/Os.hpp"
#include "config/MemoryAllocation.hpp"

namespace WiseFsw {

Sim::Cooperative cooperative;

void setupTopology(const TopologyState& state) {
    Os::init();
    Os::Task::registerTaskRegistry(&cooperative);
    Os::Queue::setRegistry(&cooperative);
    initComponents(state);
    setBaseIds();
    connectComponents();
    configComponents(state);
    regCommands();
    readParameters();
    loadParameters();
    startTasks(state);
}

const Os::Queue* step(U64 nanoseconds, U32& written) {
    Fw::MemoryAllocation::InitAllocator::instance().close();
    simTime.set(nanoseconds);
    const Os::Queue* stuck = cooperative.pump();
    if (stuck != nullptr) {
        return stuck;
    }
    labBusDriver.push();
    simTime.tick();
    written = labBusDriver.takeWritten();
    return nullptr;
}

}  // namespace WiseFsw
