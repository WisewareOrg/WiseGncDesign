register_fprime_module(
  fsw_fprime_deployment_@CONFIGURATION@
  AUTOCODER_INPUTS
    "${FPRIME_PROJECT_ROOT}/fsw/fpp/gnc/@CONFIGURATION@.fpp"
    "${CMAKE_CURRENT_LIST_DIR}/@CONFIGURATION@Fsw.fpp"
  SOURCES
    "${CMAKE_CURRENT_LIST_DIR}/@CONFIGURATION@FswTopology.cpp"
  HEADERS
    "${CMAKE_CURRENT_LIST_DIR}/@CONFIGURATION@FswTopology.hpp"
    "${CMAKE_CURRENT_LIST_DIR}/@CONFIGURATION@FswTopologyDefs.hpp"
  DEPENDS
    fsw_fprime_deployment_instances
)
