  HEADERS
    "${CMAKE_CURRENT_LIST_DIR}/@CONFIGURATION@FswTopology.hpp"
    "${CMAKE_CURRENT_LIST_DIR}/@CONFIGURATION@FswTopologyDefs.hpp"
  DEPENDS
    fsw_fprime_deployment_instances
    fsw_fpp_gnc
)
